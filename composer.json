{
    "name": "ernestdefoe/topic-map",
    "description": "Discourse-style topic map for Flarum 2 — views, likes, links, top participants and read time under the first post, plus a Top Replies panel.",
    "keywords": [
        "flarum",
        "flarum-extension",
        "topic-map",
        "summary",
        "views"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Ernest Defoe",
            "email": "ernestdefoe@gmail.com"
        }
    ],
    "support": {
        "forum": "https://discuss.flarum.org/d/39520-topic-map",
        "issues": "https://github.com/ernestdefoe/topic-map/issues",
        "source": "https://github.com/ernestdefoe/topic-map"
    },
    "require": {
        "php": "^8.2",
        "flarum/core": "^2.0"
    },
    "suggest": {
        "flarum/likes": "Enables the likes stat and the Top Replies panel (^2.0).",
        "fof/reactions": "Alternative engagement source for the stat and Top Replies (^2.0)."
    },
    "autoload": {
        "psr-4": {
            "Ernestdefoe\\TopicMap\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ernestdefoe\\TopicMap\\Tests\\": "tests/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Topic Map",
            "category": "feature",
            "icon": {
                "name": "fas fa-map",
                "backgroundColor": "#4f46e5",
                "color": "#fff"
            }
        }
    },
    "require-dev": {
        "flarum/phpstan": "^2.0",
        "flarum/testing": "^2.0",
        "flarum/likes": "^2.0"
    },
    "scripts": {
        "test": [
            "@test:integration"
        ],
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php",
        "analyse:phpstan": "phpstan analyse"
    },
    "scripts-descriptions": {
        "test": "Runs all tests.",
        "test:integration": "Runs all integration tests.",
        "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
        "analyse:phpstan": "Run static analysis"
    },
    "minimum-stability": "beta",
    "prefer-stable": true
}
